<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="ultrasonic_joint" type="fixed">
        <parent link="chassis"/>
        <child link="ultrasonic_link"/>
        <origin xyz="${chassis_length+0.01} 0 ${chassis_height-0.02}" rpy="0 0 0"/>
    </joint>

    <link name="ultrasonic_link">
        <visual>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.1" x="0.02" y="0.04" z="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="ultrasonic_link">

        <sensor name="ultrasonic_sensor" type="gpu_lidar">
            <pose> 0 0 0.01 0 0 0 </pose>
            <update_rate>20</update_rate>
            <visualize>false</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>5</samples>
                        <min_angle>-0.26</min_angle>
                        <max_angle>0.26</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.02</min>
                    <max>4.0</max>
                </range>
            </lidar>
                <topic>ultrasonic/scan</topic>
                <gz_frame_id>ultrasonic_link</gz_frame_id>
        </sensor>
    </gazebo>

</robot>